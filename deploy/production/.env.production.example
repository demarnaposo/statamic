# Production env for deploy/production/compose.yaml. Copy to .env.production (never commit it), fill in, then
# once: `ln -s .env.production .env` so a plain `docker compose up -d` finds it (or pass --env-file .env.production).
# Read twice: by Compose (variable interpolation in compose.yaml) and by every PHP container (env_file).
# Values marked "computed" are set by compose.yaml and must NOT be set here (APP_URL, LANDING_URL, CORS, …).

# ---- Compose ----
COMPOSE_PROJECT_NAME=sertifika
# `db` = bundled MariaDB container. External DB (RDS, managed MariaDB): leave empty and set DB_HOST.
COMPOSE_PROFILES=db
# Build on the server: paths to the two repositories (relative to this folder or absolute).
PLATFORM_CONTEXT=../..
LANDING_CONTEXT=../../../landing
# Pull from a registry instead: set the names and tag, then `docker compose pull && docker compose up -d --no-build`.
PLATFORM_IMAGE=sertifika/platform
LANDING_IMAGE=sertifika/landing
IMAGE_TAG=latest

# ---- Domains & edge (Caddy) ----
LANDING_DOMAIN=sertifika.id
APP_DOMAIN=app.sertifika.id
ADMIN_DOMAIN=admin.sertifika.id
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=admin@sertifika.id
# Space-separated IPs/CIDRs allowed on ADMIN_DOMAIN, e.g. "203.0.113.10/32 198.51.100.0/24". Empty = everyone.
ADMIN_ALLOWED_IPS=
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# ---- Laravel ----
APP_NAME=Sertifika
# php artisan key:generate --show (or: echo "base64:$(openssl rand -base64 32)"). Never rotate casually:
# NPWP is encrypted with it; use APP_PREVIOUS_KEYS when rotating.
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
LOG_LEVEL=info
BCRYPT_ROUNDS=12
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
PORTAL_PREFIX=portal

# ---- Database ----
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=statamic
DB_USERNAME=statamic
DB_PASSWORD=
# Only used by the bundled mariadb container (profile `db`).
DB_ROOT_PASSWORD=

# ---- Redis (cache, session, queue) ----
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PREFIX=sertifika-

# ---- Mail (SMTP) ----
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@sertifika.id
MAIL_FROM_NAME=Sertifika

# ---- Landing rebuild (Statamic → queue → landing-builder) ----
# Random secret shared by the queue worker and landing-builder: openssl rand -hex 32
DEPLOY_HOOK_TOKEN=
ASTRO_DEPLOY_DEBOUNCE_SECONDS=60

# ---- Catalog ----
CATALOG_CACHE_TTL=86400
CATALOG_API_RATE_LIMIT=120
CATALOG_TIMEZONE=Asia/Jakarta

# ---- Statamic ----
STATAMIC_LICENSE_KEY=
STATAMIC_PRO_ENABLED=false
STATAMIC_TWO_FACTOR_ENABLED=true
STATAMIC_REVISIONS_ENABLED=false
STATAMIC_GRAPHQL_ENABLED=false
STATAMIC_API_ENABLED=false
STATAMIC_STATIC_CACHING_STRATEGY=null
STATAMIC_DISPLAY_TIMEZONE=Asia/Jakarta
STATAMIC_CP_DEFAULT_TIMEZONE=Asia/Jakarta
STATAMIC_LOCALIZE_DATES=true

# ---- Tuning ----
APP_FPM_MAX_CHILDREN=16
ADMIN_FPM_MAX_CHILDREN=6
