# Local test of the production stack on the Mac, next to the Podman dev stack (which owns port 80).
# Throwaway values only: never reuse for a real server. See docs/deployment.md ("Uji lokal").
#   docker compose --env-file local-test.env up -d --build
#   docker compose --env-file local-test.env down -v
COMPOSE_PROJECT_NAME=sertifika-test
COMPOSE_PROFILES=db
ENV_FILE=local-test.env
PLATFORM_CONTEXT=../..
LANDING_CONTEXT=../../../../../astro
PLATFORM_IMAGE=localhost/sertifika-test-platform
LANDING_IMAGE=localhost/sertifika-test-landing
IMAGE_TAG=local

LANDING_DOMAIN=landing.localhost
APP_DOMAIN=app.localhost
ADMIN_DOMAIN=admin.localhost
ACME_EMAIL=test@example.com
# Plain HTTP on non-default ports (no certificates); URLs carry the port.
CADDY_SCHEME=http://
URL_SCHEME=http
URL_PORT_SUFFIX=:8880
EDGE_HTTP_PORT=8880
EDGE_HTTPS_PORT=8443
ADMIN_ALLOWED_IPS=

APP_NAME=Sertifika
APP_KEY=base64:0ZrLZyz9+jlX1UxOO+G88uW03ZUkVKcEUitP0moGkHk=
APP_DEBUG=false
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_LEVEL=info
SESSION_SECURE_COOKIE=false

DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=statamic
DB_USERNAME=statamic
DB_PASSWORD=test-db-password
DB_ROOT_PASSWORD=test-root-password

REDIS_HOST=redis
REDIS_PASSWORD=test-redis-password
REDIS_PREFIX=sertifika-

# Mail is written to the log (no SMTP in the test stack).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@sertifika.test
MAIL_FROM_NAME=Sertifika

DEPLOY_HOOK_TOKEN=test-deploy-hook-token
# Short debounce so the rebuild test is quick.
ASTRO_DEPLOY_DEBOUNCE_SECONDS=5

STATAMIC_TWO_FACTOR_ENABLED=true
STATAMIC_DISPLAY_TIMEZONE=Asia/Jakarta
STATAMIC_CP_DEFAULT_TIMEZONE=Asia/Jakarta
